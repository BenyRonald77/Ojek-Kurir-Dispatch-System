DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=20"
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"
REDIS_URL="redis://localhost:6379"

PORT=3000

# Radius pencarian driver terdekat (meter)
DISPATCH_SEARCH_RADIUS_M=5000

# Berapa detik driver punya waktu merespons sebelum order ditawarkan ke driver berikutnya
DISPATCH_OFFER_TIMEOUT_S=15
